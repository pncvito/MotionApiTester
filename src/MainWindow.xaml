<Window x:Class="MotionApiTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:MotionApiTester.ViewModels"
        xmlns:models="clr-namespace:MotionApiTester.Models"
        Title="MotionApiTester · OptoFidelity API 测试工具"
        Height="780" Width="1320"
        MinWidth="900" MinHeight="640"
        Icon="app.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <!-- 无系统标题栏：由 WindowChrome 提供拖动区(顶部 32px)、边缘缩放与系统菜单，
         窗口按钮在下方标题栏内自绘 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- 快捷键在 MainWindow.xaml.cs 的 OnPreviewKeyDown 里统一处理。
         原先写在这儿的 KeyBinding 是 Freezable、不在可视树上，Command="{Binding ...}"
         解析不到 Window 的 DataContext，四个键全部静默失效（见 code-behind 注释）。 -->

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- 转换器(只保留实际使用的) -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <vm:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <vm:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <vm:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>

        <!-- 按钮样式:4 种 -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="BtnSuccess" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{DynamicResource SuccessFgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SuccessBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessFgBrush}"/>
        </Style>
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerFgBrush}"/>
        </Style>

        <!-- 树节点模板 -->
        <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeVm}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="2,1">
                <TextBlock Text="{Binding Icon}" Foreground="{Binding IconColor}" Width="18" TextAlignment="Center"/>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Badge}" Margin="6,0,0,0" Foreground="{DynamicResource SubTextBrush}" FontSize="10" VerticalAlignment="Center"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- TreeViewItem 选中蓝色左边框。
             注意：不要再给 TreeView 单独设 ItemContainerStyle（会盖掉这个隐式样式、
             让选中行的蓝色左边框失效）；展开状态也统一由这里绑定。 -->
        <Style TargetType="TreeViewItem">
            <!-- IsExpanded 绑到节点数据上，于是"展开/折叠所有"遍历数据源即可生效 ——
                 树开了虚拟化，靠 ItemContainerGenerator 拿容器只能覆盖已实化的那几层。
                 TreeNodeVm.IsExpanded 默认 true，与原先写死的 Value="True" 行为一致。 -->
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Padding" Value="2,1"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 标签徽章 -->
        <Style x:Key="TagBadge" TargetType="TextBlock">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- 窗口控制按钮(最小化/最大化/关闭)。所在区域属于 WindowChrome 的拖动区,
             必须开 IsHitTestVisibleInChrome,否则点击会变成拖动窗口 -->
        <Style x:Key="WindowBtn" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TitleBarBtnHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowBtnClose" TargetType="Button" BasedOn="{StaticResource WindowBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CloseHoverBrush}"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="23*"/>
            <ColumnDefinition Width="142*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 窗口标题栏(替代系统标题栏:承担拖动、双击最大化、窗口按钮) -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Grid.ColumnSpan="2">
            <Grid Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0">
                    <!-- 应用图标：与 exe / 任务栏同一份 app.ico -->
                    <Image Source="app.ico" Width="20" Height="20" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="OptoFidelity API 测试工具" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="{Binding MachineTypeText, StringFormat='机型: {0}'}" FontSize="11" Foreground="{DynamicResource SubTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="来自 ConfigHardware\MachineType.json">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MachineTypeText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MachineTypeText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button x:Name="BtnMinimize" Style="{StaticResource WindowBtn}" Click="BtnMinimize_Click" ToolTip="最小化">
                        <TextBlock Text="─"/>
                    </Button>
                    <Button x:Name="BtnMaximize" Style="{StaticResource WindowBtn}" Click="BtnMaximize_Click" ToolTip="最大化 / 还原">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="□"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="{x:Static WindowState.Maximized}">
                                            <Setter Property="Text" Value="❐"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource WindowBtnClose}" Click="BtnClose_Click" ToolTip="关闭">
                        <TextBlock Text="✕"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Grid.ColumnSpan="2">
            <Grid Height="44" Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource BtnPrimary}" Command="{Binding LoadDeviceCommand}" ToolTip="重新加载当前设备目录 (Ctrl+O)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂" Margin="0,0,6,0"/>
                            <TextBlock Text="加载 DLL"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnBase}" Command="{Binding UnloadCommand}" ToolTip="清空界面状态(程序集无法从进程卸载)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,6,0"/>
                            <TextBlock Text="卸载"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- 设备管理(切换 / 添加 / 移除)已挪进「⚙ 设置」窗口，
                         工具栏只保留搜索与全局开关，避免顶部堆太多控件 -->
                    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="0" Margin="0,0,8,0" CornerRadius="4"
                            Width="240" Height="28" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                     ToolTip="搜索方法/类型名 (Ctrl+F)" Height="26" VerticalContentAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Button Style="{StaticResource BtnBase}" Command="{Binding ToggleThemeCommand}" ToolTip="切换主题">
                        <TextBlock Text="🌓"/>
                    </Button>
                    <Button Style="{StaticResource BtnBase}" Command="{Binding OpenSettingsCommand}" ToolTip="设置（设备管理：切换 / 添加 / 移除 也在这里）">
                        <TextBlock Text="⚙"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 状态栏(顶部,短暂状态) -->
        <Border Grid.Row="2" Background="{DynamicResource StatusBarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6" Grid.ColumnSpan="2">
            <TextBlock Text="{Binding StatusText}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding StatusText}"/>
        </Border>

        <!-- 主内容(三栏)：独占弹性行。
             原先这一层用负 Margin + RowSpan 覆盖在状态栏与日志之上，
             导致日志展开后被整块盖住。现改为各行独立占位：本层占弹性行，
             日志独占下一行，展开时真实挤压本层高度 —— 不再互相遮挡。 -->
        <Grid Grid.Row="3" Grid.ColumnSpan="2" MinHeight="180">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="320" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- 左：API 树 -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- 面板头 -->
                    <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="API 树" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SubTextBrush}"/>
                            <TextBlock Text="{Binding TotalTypesCount, StringFormat='· {0} 类型'}" Margin="6,0,0,0" Foreground="{DynamicResource SubTextBrush}" FontSize="10"/>
                            <TextBlock Text="{Binding TotalMethodsCount, StringFormat='· {0} 方法'}" Margin="6,0,0,0" Foreground="{DynamicResource SubTextBrush}" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <!-- 树 -->
                    <TreeView Grid.Row="1" x:Name="TvApi"
                              ItemsSource="{Binding FilteredTreeRoots}"
                              SelectedItemChanged="TvApi_SelectedItemChanged"
                              Background="Transparent" BorderThickness="0"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="📋 复制签名" Click="MenuCopySignature_Click"/>
                                <MenuItem Header="📋 复制完整名" Click="MenuCopyFullName_Click"/>
                                <Separator/>
                                <MenuItem Header="展开所有" Click="MenuExpandAll_Click"/>
                                <MenuItem Header="折叠所有" Click="MenuCollapseAll_Click"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <!-- 注意:不要再设置 TreeView.ItemContainerStyle,
                             否则会覆盖 Window.Resources 里的隐式 TreeViewItem 样式,
                             导致选中行的蓝色左边框高亮失效。 -->
                    </TreeView>
                </Grid>
            </Border>

            <!-- 中：方法详情 -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Border Grid.Column="2" Background="{DynamicResource PanelBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 空状态 -->
                    <Grid Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource PanelBrush}"
                          Visibility="{Binding SelectedTreeNode, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="64" Opacity="0.3" HorizontalAlignment="Center"/>
                            <TextBlock Text="从左侧选择一个方法" Foreground="{DynamicResource SubTextBrush}" FontSize="14" Margin="0,8,0,0"/>
                            <TextBlock Text="或属性 / 字段" Foreground="{DynamicResource SubTextBrush}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 详情内容(选中时) -->
                    <StackPanel Grid.Row="0" Margin="16,12,16,8"
                                Visibility="{Binding SelectedTreeNode, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverted}">
                        <!-- 修饰符标签(颜色走主题令牌,深色主题同样可读) -->
                        <WrapPanel Margin="0,0,0,8">
                            <TextBlock Text="PUBLIC" Style="{StaticResource TagBadge}" Background="{DynamicResource SuccessBgBrush}" Foreground="{DynamicResource SuccessFgBrush}"/>
                            <TextBlock Text="STATIC" Style="{StaticResource TagBadge}" Background="{DynamicResource WarnBgBrush}" Foreground="{DynamicResource WarnFgBrush}"
                                       Visibility="{Binding SelectedMethod.IsStatic, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}"/>
                            <TextBlock Text="INSTANCE" Style="{StaticResource TagBadge}" Background="{DynamicResource InfoBgBrush}" Foreground="{DynamicResource InfoFgBrush}"
                                       Visibility="{Binding SelectedMethod.IsStatic, Converter={StaticResource InverseBoolToVisibilityConverter}, FallbackValue=Collapsed}"/>
                            <TextBlock Text="📋 LOGGER" Style="{StaticResource TagBadge}" Background="{DynamicResource DangerBgBrush}" Foreground="{DynamicResource DangerFgBrush}"
                                       Visibility="{Binding SelectedMethod.HasLoggerParameter, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}"/>
                            <TextBlock Text="ASYNC" Style="{StaticResource TagBadge}" Background="{DynamicResource PurpleBgBrush}" Foreground="{DynamicResource PurpleFgBrush}"
                                       Visibility="{Binding SelectedMethod.IsAsync, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}"/>
                            <TextBlock Text="PROPERTY" Style="{StaticResource TagBadge}" Background="{DynamicResource PurpleBgBrush}" Foreground="{DynamicResource PurpleFgBrush}"
                                       Visibility="{Binding SelectedProperty, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverted}"/>
                            <TextBlock Text="FIELD" Style="{StaticResource TagBadge}" Background="{DynamicResource NeutralBgBrush}" Foreground="{DynamicResource NeutralFgBrush}"
                                       Visibility="{Binding SelectedField, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverted}"/>
                            <TextBlock Text="CONSTRUCTOR" Style="{StaticResource TagBadge}" Background="{DynamicResource InfoBgBrush}" Foreground="{DynamicResource InfoFgBrush}"
                                       Visibility="{Binding SelectedMethod.IsConstructor, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}"/>
                        </WrapPanel>
                        <!-- 签名(可复制) -->
                        <Border Background="{DynamicResource CodeBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                            <TextBox Text="{Binding SignatureText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource CodeFgBrush}" TextWrapping="NoWrap"
                                     Padding="0" MinHeight="20" VerticalScrollBarVisibility="Disabled"
                                     HorizontalScrollBarVisibility="Auto"/>
                        </Border>
                        <!-- 摘要/文档 -->
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="0,8,0,8" Margin="0,8,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SubTextBrush}">
                                <Run Text="📄 " FontSize="12"/>
                                <Run Text="{Binding SelectedMethod.Summary, FallbackValue='(无 XML 文档 — 可在依赖项查看返回类型与参数)', TargetNullValue='(无 XML 文档)'}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- Tab 区域 -->
                    <TabControl Grid.Row="1" x:Name="TcDetail" Margin="16,0,16,8"
                                Background="Transparent" BorderBrush="{DynamicResource BorderBrush}"
                                Visibility="{Binding SelectedTreeNode, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverted}">
                        <!-- 参数输入 -->
                        <TabItem Header="参数输入">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="8">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding SelectedMethod.Parameters.Count, StringFormat='参数 ({0})'}" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="📋 填默认" Style="{StaticResource BtnBase}" Click="BtnFillDefaults_Click"/>
                                            <Button Content="🗑 清空" Style="{StaticResource BtnBase}" Click="BtnClearParams_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding SelectedMethod.Parameters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="40"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock>
                                                            <Run Text="{Binding Name}" FontFamily="Consolas" FontWeight="SemiBold"/>
                                                            <Run Text="{Binding TypeName, StringFormat=' {0}'}" Foreground="{DynamicResource SubTextBrush}" FontSize="11"/>
                                                        </TextBlock>
                                                        <TextBlock Text="OPTIONAL" FontSize="9" Foreground="{DynamicResource WarnFgBrush}" Background="{DynamicResource WarnBgBrush}" Padding="3,1"
                                                                   HorizontalAlignment="Left" Margin="0,2,0,0"
                                                                   Visibility="{Binding IsOptional, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                    <!-- type-tag 在输入框内 overlay -->
                                                    <Grid Grid.Column="1" Margin="4,0">
                                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                 IsEnabled="{Binding IsLogger, Converter={StaticResource InverseBoolConverter}}"
                                                                 ToolTip="{Binding ValueHint}"
                                                                 Padding="4,0,60,0"/>
                                                        <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,1"
                                                                HorizontalAlignment="Right" Padding="4,0" Margin="0,1,1,1">
                                                            <TextBlock Text="{Binding TypeName}" FontSize="10" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                    <CheckBox Grid.Column="2" Margin="4,0,0,0" ToolTip="勾选后强制传 null(忽略输入值)"
                                                              IsChecked="{Binding PassNull, Mode=TwoWay}"
                                                              Visibility="{Binding IsLogger, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                              VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- JSON 高级输入 -->
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="📦 高级：JSON 数组（整组参数，按位置覆盖上面的输入）" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TbJsonArgs" Height="60" AcceptsReturn="True"
                                                     FontFamily="Consolas" FontSize="12"
                                                     Text="{Binding JsonArgsOverride, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="整组参数按位置覆盖，个数需与方法参数一致。数组参数直接写 JSON 数组，例如：[100.5, [1.0, 2.0], true, &quot;abc&quot;]（第 2 个参数是 double[]）。对象类型参数暂不支持，会明确报错。"
                                                     Background="{DynamicResource BackgroundBrush}"
                                                     Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="💡 填入后整组覆盖逐参数输入；切换选中项会自动清空" FontSize="10" Foreground="{DynamicResource SubTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <!-- IL 签名 -->
                        <TabItem Header="原始签名 (IL)">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                                <TextBox x:Name="TbIlSignature" FontFamily="Consolas" FontSize="12"
                                         Background="{DynamicResource BackgroundBrush}"
                                         Foreground="{DynamicResource TextBrush}"
                                         BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </TabItem>
                        <!-- XML 文档 -->
                        <TabItem Header="XML 文档">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                                <TextBlock TextWrapping="Wrap" FontSize="12" Text="{Binding SelectedMethod.Summary, FallbackValue='(无 XML 文档)'}"/>
                            </ScrollViewer>
                        </TabItem>
                        <!-- 依赖 -->
                        <TabItem Header="依赖项">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                                <ItemsControl ItemsSource="{Binding MethodDependencies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource SubTextBrush}" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="Consolas" FontSize="12"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <!-- 操作栏 + 上次耗时 + 调用结果 -->
                    <Grid Grid.Row="2" Margin="16,0,16,16"
                          Visibility="{Binding SelectedTreeNode, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverted}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- 操作栏 -->
                        <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,0" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource BtnSuccess}" Command="{Binding InvokeCommand}" ToolTip="调用 (F5)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▶" Margin="0,0,6,0"/>
                                        <TextBlock Text="调用方法"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource BtnBase}" Command="{Binding CancelInvokeCommand}" ToolTip="取消">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⏹" Margin="0,0,6,0"/>
                                        <TextBlock Text="取消"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Style="{StaticResource BtnBase}" Click="BtnCopySignature_Click" ToolTip="复制签名">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋" Margin="0,0,6,0"/>
                                        <TextBlock Text="复制签名"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        <!-- 调用结果(卡片 — KV 结构) -->
                        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,1" Padding="0">
                            <Border x:Name="ResultCard" Background="{DynamicResource PanelBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border x:Name="ResultHead" Grid.Row="0" Background="{DynamicResource SuccessBgBrush}" Padding="10,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TbResultHead" Text="等待调用" Foreground="{DynamicResource SuccessFgBrush}" FontWeight="SemiBold" FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ResultReturnType}" Foreground="{DynamicResource SuccessFgBrush}" FontFamily="Consolas" FontSize="11" Margin="8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding LastCallTime}" Foreground="{DynamicResource SuccessFgBrush}" FontFamily="Consolas" FontSize="11"/>
                                        </Grid>
                                    </Border>
                                    <ScrollViewer Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Background="{DynamicResource PanelBrush}" Margin="0">
                                            <!-- KV 列表 -->
                                            <Grid Margin="10,8,10,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="返回值类型" Foreground="{DynamicResource SubTextBrush}" FontSize="11" Grid.Row="0" Grid.Column="0"/>
                                                <TextBlock Text="{Binding ResultReturnType}" FontFamily="Consolas" FontSize="11" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap"/>
                                                <TextBlock Text="返回值 (JSON)" Foreground="{DynamicResource SubTextBrush}" FontSize="11" Grid.Row="1" Grid.Column="0"/>
                                                <TextBlock Text="{Binding ResultReturnValue}" FontFamily="Consolas" FontSize="11" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap"/>
                                                <TextBlock Text="实例类型" Foreground="{DynamicResource SubTextBrush}" FontSize="11" Grid.Row="2" Grid.Column="0"/>
                                                <TextBlock Text="{Binding ResultInstanceType}" FontFamily="Consolas" FontSize="11" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap"/>
                                                <TextBlock Text="线程" Foreground="{DynamicResource SubTextBrush}" FontSize="11" Grid.Row="3" Grid.Column="0"/>
                                                <TextBlock Text="{Binding ResultThread}" FontFamily="Consolas" FontSize="11" Grid.Row="3" Grid.Column="1"/>
                                            </Grid>
                                            <!-- 完整消息(可滚动) -->
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,0">
                                                <TextBox Text="{Binding ResultFullMessage, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                                         BorderThickness="0" Background="Transparent" Padding="10,6" MinHeight="40" MaxHeight="120"
                                                         Foreground="{DynamicResource TextBrush}"
                                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- 右：调用历史 + 原生 DLL 切换 -->
            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Border Grid.Column="4" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="调用历史" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SubTextBrush}"/>
                                <TextBlock Text="{Binding HistoryItems.Count, StringFormat='· {0} 条'}" Margin="6,0,0,0" Foreground="{DynamicResource SubTextBrush}" FontSize="10"/>
                                <TextBlock Text="{Binding NativeDlls.Count, StringFormat='· 原生 {0}'}" Margin="6,0,0,0" Foreground="{DynamicResource SubTextBrush}" FontSize="10"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource BtnBase}" Height="22" Padding="8,0" Margin="0" Command="{Binding ClearHistoryCommand}" ToolTip="清空调用历史 (Ctrl+H)">
                                    <TextBlock Text="🗑" FontSize="11"/>
                                </Button>
                                <Button Style="{StaticResource BtnBase}" Height="22" Padding="8,0" Margin="4,0,0,0" Command="{Binding ShowNativeDllsCommand}" ToolTip="查看原生 DLL 与 P/Invoke 模板">
                                    <TextBlock Text="⚙ 原生" FontSize="11"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TabControl Grid.Row="1" x:Name="RightTabs" SelectedIndex="{Binding RightTabIndex}"
                                Background="Transparent" BorderThickness="0">
                        <TabItem Header="调用历史">
                            <ListBox x:Name="LbHistory" ItemsSource="{Binding HistoryItems}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm:ss}" Foreground="{DynamicResource SubTextBrush}" FontFamily="Consolas" FontSize="10" DockPanel.Dock="Left"/>
                                            <Border DockPanel.Dock="Right" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4,1" CornerRadius="8">
                                                <TextBlock Text="{Binding ElapsedMs, StringFormat={}{0}ms}" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                                            </Border>
                                            <TextBlock HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding MethodName}" FontFamily="Consolas" FontSize="11" Margin="0,4,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border Background="{DynamicResource SuccessBgBrush}" Padding="6,1" CornerRadius="8"
                                                    Visibility="{Binding Success, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="✓ OK" Foreground="{DynamicResource SuccessFgBrush}" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Background="{DynamicResource DangerBgBrush}" Padding="6,1" CornerRadius="8"
                                                    Visibility="{Binding Success, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                <TextBlock Text="✗ ERR" Foreground="{DynamicResource DangerFgBrush}" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Text="{Binding Result}" Foreground="{DynamicResource SubTextBrush}" FontSize="11" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                        <!-- 原生 DLL:枚举 + P/Invoke 模板(不调用) -->
                        <TabItem Header="原生 DLL">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ListBox Grid.Row="0" ItemsSource="{Binding NativeDlls}" SelectedItem="{Binding SelectedNativeDll}"
                                         Background="Transparent" BorderThickness="0"
                                         Visibility="{Binding HasNativeDlls, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Border Background="{DynamicResource InfoBgBrush}" Padding="5,1" CornerRadius="8">
                                                            <TextBlock Text="{Binding Architecture}" Foreground="{DynamicResource InfoFgBrush}" FontSize="10" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource NeutralBgBrush}" Padding="5,1" CornerRadius="8" Margin="4,0,0,0">
                                                            <TextBlock Text="{Binding Role}" Foreground="{DynamicResource NeutralFgBrush}" FontSize="10"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Grid.Row="0" Text="未发现原生 DLL" Foreground="{DynamicResource SubTextBrush}" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasNativeDlls, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                <Grid Grid.Row="1" Margin="8,6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="P/Invoke 模板" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,4"/>
                                    <TextBox Grid.Row="1" Text="{Binding PInvokeTemplate, Mode=OneWay}" IsReadOnly="True"
                                             FontFamily="Consolas" FontSize="11" Height="110" AcceptsReturn="True"
                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             Background="{DynamicResource CodeBgBrush}" Foreground="{DynamicResource CodeFgBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}"/>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Style="{StaticResource BtnBase}" Height="24" Padding="8,0" Margin="0"
                                                Command="{Binding CopyPInvokeCommand}" ToolTip="复制模板">
                                            <TextBlock Text="📋 复制" FontSize="11"/>
                                        </Button>
                                        <Button Style="{StaticResource BtnBase}" Height="24" Padding="8,0" Margin="4,0,0,0"
                                                Command="{Binding RefreshPInvokeCommand}" ToolTip="重新生成模板">
                                            <TextBlock Text="🔄 刷新" FontSize="11"/>
                                        </Button>
                                        <Button Style="{StaticResource BtnBase}" Height="24" Padding="8,0" Margin="4,0,0,0"
                                                Command="{Binding RefreshNativeDllsCommand}" ToolTip="重新扫描原生 DLL">
                                            <TextBlock Text="🔍 重扫" FontSize="11"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- 实时日志面板 -->
        <Expander Grid.Row="4" Header="📋 实时日志" IsExpanded="False" MaxHeight="260" Grid.ColumnSpan="2"
                  Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox Grid.Row="0" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextChanged="TbLog_TextChanged"
                         FontFamily="Consolas" FontSize="11"
                         Background="{DynamicResource LogBackgroundBrush}"
                         Foreground="{DynamicResource LogForegroundBrush}" Height="180"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,2">
                    <Button Style="{StaticResource BtnBase}" Command="{Binding ClearLogCommand}">
                        <TextBlock Text="🗑 清空 (Ctrl+L)"/>
                    </Button>
                    <Button Style="{StaticResource BtnBase}" Command="{Binding ExportLogCommand}" Margin="4,0,0,0">
                        <TextBlock Text="💾 导出"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Expander>

        <!-- 底部状态栏(分段)：左段信息 + 右段快捷键提示。
             原来是一个横向 StackPanel 中间垫 Width=60 的占位块 —— 那只是"顶开一点"，
             窗口变宽时就停在中间了。改成两列 Grid：信息占 *、提示占 Auto 并靠右，
             空间不够时由信息侧先被裁掉，提示始终贴在最右端。 -->
        <Border Grid.Row="5" Background="{DynamicResource BottomBarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,3" Grid.ColumnSpan="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左段用三列：状态 / 「机型 · 型号 DLL」/ 计数。
                     摘要单独占 * 列才能真的走 TextTrimming（横向 StackPanel 会给子元素无限宽，
                     省略号永远不触发，只会硬裁），窄窗口下优先牺牲摘要、计数始终可见。 -->
                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessFgBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="就绪" Margin="6,0,0,0" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                        <TextBlock Text="|" Margin="12,0" Foreground="{DynamicResource SubTextBrush}"/>
                        <TextBlock Text="📦" Margin="0,0,4,0" FontSize="11"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               Text="{Binding LoadedAssemblySummary, FallbackValue='(未加载)', TargetNullValue='(未加载)'}"
                               FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding CurrentLoadedPath}"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="|" Margin="12,0" Foreground="{DynamicResource SubTextBrush}"/>
                        <TextBlock Text="{Binding TotalTypesCount, StringFormat='🔷 {0} 类型'}" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                        <TextBlock Text="{Binding TotalMethodsCount, StringFormat='⚙ {0} 方法'}" Margin="8,0,0,0" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                        <TextBlock Text="{Binding TotalPropertiesCount, StringFormat='📋 {0} 属性'}" Margin="8,0,0,0" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                        <TextBlock Text="{Binding TotalFieldsCount, StringFormat='▣ {0} 字段'}" Margin="8,0,0,0" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                        <TextBlock Text="|" Margin="12,0" Foreground="{DynamicResource SubTextBrush}"/>
                        <TextBlock Text="⏱ 上次:" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                        <TextBlock Text="{Binding LastElapsedMs, StringFormat='{}{0}ms'}" Margin="4,0,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessFgBrush}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4,0" CornerRadius="3">
                        <TextBlock Text="Ctrl+O" FontFamily="Consolas" FontSize="10"/>
                    </Border>
                    <TextBlock Text="加载" Margin="4,0,8,0" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4,0" CornerRadius="3">
                        <TextBlock Text="F5" FontFamily="Consolas" FontSize="10"/>
                    </Border>
                    <TextBlock Text="调用" Margin="4,0,8,0" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4,0" CornerRadius="3">
                        <TextBlock Text="Ctrl+L" FontFamily="Consolas" FontSize="10"/>
                    </Border>
                    <TextBlock Text="清空日志" Margin="4,0,8,0" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4,0" CornerRadius="3">
                        <TextBlock Text="Ctrl+H" FontFamily="Consolas" FontSize="10"/>
                    </Border>
                    <TextBlock Text="清空历史" Margin="4,0,0,0" FontSize="10" Foreground="{DynamicResource SubTextBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>