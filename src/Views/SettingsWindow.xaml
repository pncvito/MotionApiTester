<Window x:Class="MotionApiTester.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Height="600" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <!-- DataContext 由 code-behind 设成主窗口的 MainViewModel 实例，
         所以"设备"一节的绑定直接复用主窗口那套命令(切换/添加/移除)。 -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 主题 -->
                <TextBlock Text="外观" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                    <StackPanel>
                        <RadioButton x:Name="RbLight" Content="浅色主题" GroupName="Theme" Margin="0,2"/>
                        <RadioButton x:Name="RbDark" Content="深色主题" GroupName="Theme" Margin="0,2"/>
                        <RadioButton x:Name="RbSystem" Content="跟随系统" GroupName="Theme" Margin="0,2"/>
                    </StackPanel>
                </Border>

                <!-- 日志保留 -->
                <TextBlock Text="日志" FontWeight="Bold" FontSize="14" Margin="0,8,0,8"/>
                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="日志最大行数:" VerticalAlignment="Center" Margin="0,4,12,4"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TbMaxLines" Width="120" HorizontalAlignment="Left" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="导出格式:" VerticalAlignment="Center" Margin="0,4,12,4"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CbExportFormat" Width="120" HorizontalAlignment="Left" Margin="0,4" SelectedIndex="0">
                            <ComboBoxItem Content="纯文本 (.txt)"/>
                            <ComboBoxItem Content="JSON (.json)"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- 调用超时 -->
                <TextBlock Text="调用" FontWeight="Bold" FontSize="14" Margin="0,8,0,8"/>
                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="调用超时(秒):" VerticalAlignment="Center" Margin="0,4,12,4"/>
                        <TextBox Grid.Column="1" x:Name="TbTimeout" Width="80" HorizontalAlignment="Left" Margin="0,4"/>
                    </Grid>
                </Border>

                <!-- 设备管理：原先在主窗口工具栏上（设备下拉 + ▶ ＋ ✕），
                     为了顶部清爽挪到这儿；命令与主窗口共用同一个 ViewModel，
                     所以没选中设备时 ▶/✕ 依然自动置灰。 -->
                <TextBlock Text="设备" FontWeight="Bold" FontSize="14" Margin="0,8,0,4"/>
                <TextBlock Text="切换会立即重新加载该目录下的设备程序集。" FontSize="11" Foreground="Gray" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0" Height="120" Margin="0,0,8,0"
                             ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice}"
                             ToolTip="已登记的设备(devices.json)，鼠标悬停看目录">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="ToolTip" Value="{Binding Directory}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding MachineType, StringFormat=' · {0}'}"
                                               Foreground="Gray" FontSize="11" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MachineType}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MachineType}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <Button Content="▶ 切换" Width="92" Margin="0,0,0,6" Command="{Binding SwitchDeviceCommand}"
                                ToolTip="切换到选中设备并重新加载"/>
                        <Button Content="＋ 添加" Width="92" Margin="0,0,0,6" Command="{Binding AddDeviceCommand}"
                                ToolTip="用向导添加设备"/>
                        <Button Content="✕ 移除" Width="92" Command="{Binding RemoveDeviceCommand}"
                                ToolTip="从 devices.json 移除选中设备"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="80" Margin="0,0,8,0" IsCancel="True" Click="BtnCancel_Click"/>
            <Button Content="保存" Width="80" IsDefault="True" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
