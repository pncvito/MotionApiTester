<Window x:Class="MotionApiTester.Views.DeviceWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加设备"
        Height="420" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="添加新设备" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>

            <!-- 设备名称 -->
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="设备名称:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="TbName" />
            </Grid>

            <!-- 设备目录 -->
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="DLL 目录:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="TbDirectory" TextChanged="TbDirectory_TextChanged"/>
                <Button Grid.Column="2" Content="浏览..." Margin="4,0,0,0" Padding="12,4" Click="BtnBrowse_Click"/>
            </Grid>

            <!-- 扫描状态 -->
            <!-- 扫描结果框走 Warn 令牌：原先写死 #FFF8E1/#FFD54F，
                 一旦窗口跟随深色主题，浅底 + 浅色字会变成一片糊 -->
            <Border x:Name="BorderScanResult" Background="{DynamicResource WarnBgBrush}" BorderBrush="{DynamicResource WarnFgBrush}" BorderThickness="1" Padding="8" Margin="0,8" Visibility="Collapsed">
                <TextBlock x:Name="TbScanResult" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                           Foreground="{DynamicResource WarnFgBrush}"/>
            </Border>

            <!-- 候选机型 DLL -->
            <Grid Margin="0,4" x:Name="GridModelDll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="机型 DLL:" VerticalAlignment="Center"/>
                <!-- 用 ListBox 而不是 ComboBox：候选机型一般只有 1~3 个，列出来更直观；
                     而且 ComboBox 的默认模板无视 Background，深色主题下会是一块浅色。
                     ⚠️ x:Name 保持 CbModelDll 不变，code-behind 的 Items / SelectedItem 用法两种控件一致。 -->
                <ListBox Grid.Column="1" x:Name="CbModelDll" MaxHeight="80" Margin="0,2"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>

            <!-- MachineType -->
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="MachineType:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="TbMachineType" ToolTip="可选 — 用于模糊匹配"/>
            </Grid>

            <!-- 设备备注 -->
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="备注:" VerticalAlignment="Top" Margin="0,4,0,0"/>
                <TextBox Grid.Column="1" x:Name="TbNote" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>
            </Grid>
        </StackPanel>

        <!-- 按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="80" Margin="0,0,8,0" IsCancel="True" Click="BtnCancel_Click"/>
            <Button Content="添加" Width="80" IsDefault="True" Click="BtnAdd_Click" x:Name="BtnAdd" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>