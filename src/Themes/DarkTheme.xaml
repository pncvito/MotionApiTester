<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色主题 -->
    <Color x:Key="BackgroundColor">#1E1E1E</Color>
    <Color x:Key="PanelColor">#2D2D2D</Color>
    <Color x:Key="TextColor">#D4D4D4</Color>
    <Color x:Key="SubTextColor">#9CDCFE</Color>
    <Color x:Key="AccentColor">#0078D4</Color>
    <Color x:Key="BorderColor">#3C3C3C</Color>

    <!-- 状态栏 / 底部信息栏 -->
    <Color x:Key="StatusBarColor">#252526</Color>
    <Color x:Key="BottomBarColor">#252526</Color>

    <!-- 日志面板 -->
    <Color x:Key="LogBackgroundColor">#0E0E0E</Color>
    <Color x:Key="LogForegroundColor">#D4D4D4</Color>

    <!-- 选中行 -->
    <Color x:Key="RowSelectedColor">#094771</Color>

    <!-- 窗口标题栏按钮(无系统标题栏,按钮自绘) -->
    <Color x:Key="TitleBarBtnHoverColor">#3F3F3F</Color>
    <Color x:Key="CloseHoverColor">#E81123</Color>

    <!-- 语义色:成功 / 危险 / 警告 / 信息 / 紫 / 中性 / 代码块 -->
    <Color x:Key="SuccessBgColor">#1E4D2C</Color>
    <Color x:Key="SuccessFgColor">#9FE1CB</Color>
    <Color x:Key="DangerBgColor">#5C1F2C</Color>
    <Color x:Key="DangerFgColor">#F09595</Color>
    <Color x:Key="WarnBgColor">#5C4A1F</Color>
    <Color x:Key="WarnFgColor">#FAC775</Color>
    <Color x:Key="InfoBgColor">#1F3A5C</Color>
    <Color x:Key="InfoFgColor">#85B7EB</Color>
    <Color x:Key="PurpleBgColor">#3C2A55</Color>
    <Color x:Key="PurpleFgColor">#CECBF6</Color>
    <Color x:Key="NeutralBgColor">#3C3C3C</Color>
    <Color x:Key="NeutralFgColor">#D4D4D4</Color>
    <Color x:Key="CodeBgColor">#1E1E1E</Color>
    <Color x:Key="CodeFgColor">#D4D4D4</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="{StaticResource SubTextColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="StatusBarBrush" Color="{StaticResource StatusBarColor}"/>
    <SolidColorBrush x:Key="BottomBarBrush" Color="{StaticResource BottomBarColor}"/>
    <SolidColorBrush x:Key="LogBackgroundBrush" Color="{StaticResource LogBackgroundColor}"/>
    <SolidColorBrush x:Key="LogForegroundBrush" Color="{StaticResource LogForegroundColor}"/>
    <SolidColorBrush x:Key="RowSelectedBrush" Color="{StaticResource RowSelectedColor}"/>
    <SolidColorBrush x:Key="TitleBarBtnHoverBrush" Color="{StaticResource TitleBarBtnHoverColor}"/>
    <SolidColorBrush x:Key="CloseHoverBrush" Color="{StaticResource CloseHoverColor}"/>

    <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBgColor}"/>
    <SolidColorBrush x:Key="SuccessFgBrush" Color="{StaticResource SuccessFgColor}"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBgColor}"/>
    <SolidColorBrush x:Key="DangerFgBrush" Color="{StaticResource DangerFgColor}"/>
    <SolidColorBrush x:Key="WarnBgBrush" Color="{StaticResource WarnBgColor}"/>
    <SolidColorBrush x:Key="WarnFgBrush" Color="{StaticResource WarnFgColor}"/>
    <SolidColorBrush x:Key="InfoBgBrush" Color="{StaticResource InfoBgColor}"/>
    <SolidColorBrush x:Key="InfoFgBrush" Color="{StaticResource InfoFgColor}"/>
    <SolidColorBrush x:Key="PurpleBgBrush" Color="{StaticResource PurpleBgColor}"/>
    <SolidColorBrush x:Key="PurpleFgBrush" Color="{StaticResource PurpleFgColor}"/>
    <SolidColorBrush x:Key="NeutralBgBrush" Color="{StaticResource NeutralBgColor}"/>
    <SolidColorBrush x:Key="NeutralFgBrush" Color="{StaticResource NeutralFgColor}"/>
    <SolidColorBrush x:Key="CodeBgBrush" Color="{StaticResource CodeBgColor}"/>
    <SolidColorBrush x:Key="CodeFgBrush" Color="{StaticResource CodeFgColor}"/>

</ResourceDictionary>
