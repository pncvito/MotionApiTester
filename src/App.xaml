<Application x:Class="MotionApiTester.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/LightTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 全局样式。
                 ⚠️ 输入类控件必须在这里显式给出颜色：WPF 默认模板用的是**系统色**
                 （SystemColors.WindowBrush 等），不跟本应用的主题走 ——
                 不写就会出现"深色主题里冒出白色输入框"（设置窗口、设备向导尤其明显）。
                 用 DynamicResource，切换主题时会自动重取。 -->
            <Style TargetType="Button">
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="MinHeight" Value="24"/>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="4,2"/>
                <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            </Style>

            <!-- ⚠️ 这里刻意没有 ComboBox 样式：WPF 默认 ComboBox 模板不理会 Background
                 （实测深色主题下仍是浅色 chrome），要跟主题必须整个换 ControlTemplate。
                 所以本应用不再使用 ComboBox：导出格式改用单选按钮、向导的机型 DLL 改用 ListBox。 -->

            <Style TargetType="ListBox">
                <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            </Style>

            <Style TargetType="GroupBox">
                <Setter Property="Padding" Value="6"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Style>

            <!-- ⚠️ CheckBox / RadioButton 的 Foreground 也必须在这里给：
                 它们默认取系统色（深色主题下是黑字），而本应用的主题字典用的是浅字 ——
                 不覆盖就会出现"深色背景 + 黑字"看不见的情况。
                 典型受害点是设置窗口（主题三选一、导出格式二选一）与主窗口参数区的「传 null」。
                 注意只覆盖 Foreground：勾选框本身的勾选标记由系统模板绘制，
                 换它要整个 ControlTemplate，得不偿失。 -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>