<Window x:Class="MotionApiTester.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <!-- 主题 -->
            <TextBlock Text="外观" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                <StackPanel>
                    <RadioButton x:Name="RbLight" Content="浅色主题" GroupName="Theme" Margin="0,2"/>
                    <RadioButton x:Name="RbDark" Content="深色主题" GroupName="Theme" Margin="0,2"/>
                    <RadioButton x:Name="RbSystem" Content="跟随系统" GroupName="Theme" Margin="0,2"/>
                </StackPanel>
            </Border>

            <!-- 日志保留 -->
            <TextBlock Text="日志" FontWeight="Bold" FontSize="14" Margin="0,8,0,8"/>
            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="日志最大行数:" VerticalAlignment="Center" Margin="0,4,12,4"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TbMaxLines" Width="120" HorizontalAlignment="Left" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="导出格式:" VerticalAlignment="Center" Margin="0,4,12,4"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CbExportFormat" Width="120" HorizontalAlignment="Left" Margin="0,4" SelectedIndex="0">
                        <ComboBoxItem Content="纯文本 (.txt)"/>
                        <ComboBoxItem Content="JSON (.json)"/>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- 调用超时 -->
            <TextBlock Text="调用" FontWeight="Bold" FontSize="14" Margin="0,8,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="调用超时(秒):" VerticalAlignment="Center" Margin="0,4,12,4"/>
                <TextBox Grid.Column="1" x:Name="TbTimeout" Width="80" HorizontalAlignment="Left" Margin="0,4"/>
            </Grid>
        </StackPanel>

        <!-- 按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="80" Margin="0,0,8,0" IsCancel="True" Click="BtnCancel_Click"/>
            <Button Content="保存" Width="80" IsDefault="True" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>